# ─── Required Environment Variables ───────────────────────────────────────
GCP_PROJECT_ID=locus-dev-506512
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPOSITORY=owner/repository_name

# ─── GCP Authentication (GCP SDKs / ADC) ──────────────────────────────────
# Path to your Google Cloud Service Account JSON Key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/gcp-service-account-key.json

# ─── Optional Configuration & Overrides ───────────────────────────────────
GCP_REGION=us-central1

# Vertex AI / Gemini Models
CLASSIFIER_MODEL=gemini-3.1-flash-lite
RESOLVER_MODEL=gemini-3.1-pro

# Firestore Settings
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_ELEMENTS=elements
FIRESTORE_COLLECTION_HEAL_RECORDS=heal-records

# Heal Budget Settings
HEAL_BUDGET=3

# Page Object Model (POM) Discovery
POM_DIR=src
POM_GLOB=**/*.page.ts

# Diff & Webhook Settings
DIFF_MAX_CHARS=2000
LOCUS_WEBHOOK_SECRET=
LOCUS_WEBHOOK_URL=http://localhost:3000/webhook
