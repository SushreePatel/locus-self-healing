{
  "name": "locus-self-healing",
  "version": "0.1.0",
  "description": "Post-execution self-healing tool for Playwright end-to-end test suites using a two-agent Gemini architecture on Vertex AI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "dev": "ts-node src/pipeline/orchestrator.ts",
    "lint": "eslint 'src/**/*.ts' --ext .ts",
    "test": "playwright test",
    "prepare": "husky install"
  },
  "keywords": [
    "playwright",
    "self-healing",
    "test-automation",
    "gemini",
    "vertex-ai"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@google-cloud/firestore": "^7.6.0",
    "@google-cloud/vertexai": "^1.7.0",
    "@octokit/rest": "^20.1.1",
    "cheerio": "^1.2.0",
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.6.1",
    "husky": "^9.1.4",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
